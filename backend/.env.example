PORT=4000
DATABASE_URL=postgres://paperless:paperless@localhost:5432/paperless_meeting
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# Tro ly AI cho tai lieu (tom tat + hoi dap). Lay khoa tai console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5


# May chu video LiveKit.
# LIVEKIT_WS_URL de trong thi trinh duyet tu suy ra ws://<hostname dang mo trang>:7880
LIVEKIT_WS_URL=
# Dia chi HTTP backend dung de goi API quan tri cua LiveKit (doi quyen phat bieu
# cua nguoi dang o trong phong). Chay Docker tren cung may thi giu mac dinh.
LIVEKIT_HOST_URL=http://localhost:7880

# Khoa ma hoa khoa ky so bien ban truoc khi luu vao database.
# Dat mot chuoi ngau nhien dai roi GIU NGUYEN: doi gia tri thi khoa ky cu
# khong giai ma duoc (chu ky da ky van kiem tra duoc vi chi can khoa cong khai).
SIGNING_KEY_SECRET=change_me_to_a_long_random_secret
